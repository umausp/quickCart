{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickcart-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "API_SERVICE", "service": "quickcart-api" }],
  "vars": {
    "API_BASE_URL": "https://quickcart-api.pathakumashankar.workers.dev/v1",
    "NODE_ENV": "production"
  }
}
