{
  "name": "quickcart",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:mcp": "turbo run dev --parallel --filter=./services/*",
    "dev:api": "pnpm --filter @quickcart/api dev",
    "dev:web": "pnpm --filter @quickcart/web dev",
    "mcp:demo": "pnpm --filter @quickcart/scripts mcp:demo",
    "mcp:checkout-demo": "pnpm --filter @quickcart/scripts mcp:checkout-demo",
    "agg:demo": "pnpm --filter @quickcart/scripts agg:demo",
    "lint": "turbo run lint",
    "lint:boundaries": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"services/*/src/**/*.ts\" --no-eslintrc -c .eslintrc.cjs --no-error-on-unmatched-pattern",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
