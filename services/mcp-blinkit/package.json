{
  "name": "@quickcart/mcp-blinkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@quickcart/contracts": "workspace:*",
    "@quickcart/mcp-toolkit": "workspace:*",
    "@quickcart/retailer-mcp-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  }
}
